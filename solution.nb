            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}]}], "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"xyzv", "=", 
          RowBox[{"pts", "[", "pname", "]"}]}], ";", 
         RowBox[{"cs", "=", 
          RowBox[{"relevant", "[", "pname", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"ca", ",", "cb"}], "}"}], "=", "pr"}], ";", 
            "\[IndentingNewLine]", 
