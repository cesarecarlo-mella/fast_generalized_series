Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ok", "[", "q_", "]"}], ":=", 
     RowBox[{
      RowBox[{"NumberQ", "[", "q", "]"}], "&&", 
      RowBox[{"Element", "[", 
       RowBox[{"q", ",", "Reals"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"digitsOf", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "a", "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"a", "-", "b"}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "6"}]}]}], ",", "16.", ",", 
         RowBox[{"Min", "[", 
          RowBox[{"16.", ",", 
           RowBox[{"-", 
            RowBox[{"Log10", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"a", "-", "b"}], "]"}], "+", 
              RowBox[{"10", "^", 
               RowBox[{"-", "16"}]}]}], "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"Min", "[", 
        RowBox[{"16.", ",", 
         RowBox[{"-", 
          RowBox[{"Log10", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", "b"}], ")"}], "/", "a"}], "]"}], "+", 
            RowBox[{"10", "^", 
             RowBox[{"-", "16"}]}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"worstDigits", "[", 
      RowBox[{"va_", ",", "vb_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"reals", ",", "digs"}], "}"}], ",", 
       RowBox[{
        RowBox[{"reals", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "va", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ok", "[", 
              RowBox[{"va", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "]"}], "&&", 
             RowBox[{"ok", "[", 
              RowBox[{"vb", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"digs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"digitsOf", "[", 
            RowBox[{
             RowBox[{"va", "[", 
              RowBox[{"[", "#", "]"}], "]"}], ",", 
             RowBox[{"vb", "[", 
              RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
          "reals"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Min", "[", "digs", "]"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", "va", "]"}], "-", 
           RowBox[{"Length", "[", "reals", "]"}]}]}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\\n=== weight \>\"", ",", "w", ",", "\"\< ===\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"serN", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"Table", "[", 
